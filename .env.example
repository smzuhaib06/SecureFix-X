# SECUREFIX X — Environment Configuration Template
# Copy to .env and configure as needed

# ── Backend Configuration ──
PORT=8000
DEMO_REPO_PATH=demo-app
DATABASE_URL=sqlite:///./backend/securefix.db

# ── Grounded AI Provider Configuration (Optional) ──
# If unconfigured, SECUREFIX X defaults to the deterministic evidence-reasoning engine.
# To enable real LLM reasoning, provide one of the following API keys:
# GOOGLE_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# ── Frontend Configuration ──
NEXT_PUBLIC_API_URL=http://localhost:8000
